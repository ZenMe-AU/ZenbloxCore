TARGET_ENV=zeninstaller
SUBSCRIPTION_ID=your-subscription-id
# The ZenInstaller origin(s) that call /register and /negotiate from the browser
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173
# Exact sub claims from the pipeline repo's existing federated credentials, comma separated.
# Read them with: az ad app federated-credential list --id <existing-AZURE_CLIENT_ID> -o json
GITHUB_OIDC_SUBJECTS=repo:ZenMe-AU/ZBCorpArchitecture:environment:PROD,repo:ZenMe-AU/ZBCorpArchitecture:environment:TEST

# HUB_NAME=terminal              # optional, defaults to "terminal"
# WEB_PUBSUB_SKU=Standard_S1     # optional, defaults to Free_F1 (20 connections, 20k messages/day)
# LOCATION=Australia East        # optional, defaults to "Australia East" in variables.tf
