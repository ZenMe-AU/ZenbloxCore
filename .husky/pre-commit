#!/usr/bin/env sh
cd "$(git rev-parse --show-toplevel)"

BRANCH="$(git rev-parse --abbrev-ref HEAD)"

# Checks for all branches
echo "Type-checking root tsconfig.json..."
if ! pnpm exec tsc --project tsconfig.json --noEmit --incremental false; then
  echo "Warning: TypeScript check failed; commit will continue." >&2
fi

# Extra checks only on main
if [ "$BRANCH" = "main" ]; then
  echo "Running main-only pre-commit checks..."
  npx lint-staged --config .codingstandards/lint-staged.config.mjs --relative --no-stash
  # add more main-only commands here
fi
