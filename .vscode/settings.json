{
  //This file is used to store local workspace settings.
  // Azure Functions settings are duplicated for each workspace that uses azure functions.
  // "azureFunctions.deploySubpath": "api",
  // "azureFunctions.postDeployTask": "Install Dependencies",
  // "azureFunctions.projectLanguage": "JavaScript",
  // "azureFunctions.projectRuntime": "~4",
  // "azureFunctions.projectLanguageModel": 4,
  // "azureFunctions.preDeployTask": "npm prune (functions)",
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "eslint.enable": true,
  "eslint.format.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "endOfLine": "auto",
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.parquet": "duckdb.dataFileViewer",
    "*.csv": "duckdb.dataFileViewer",
    "*.tsv": "duckdb.dataFileViewer",
    "*.xlsx": "duckdb.dataFileViewer"
  },
  "azurite.location": "${workspaceFolder}/azurite",
  "azurite.debug": true,
  "azurite.silent": true,
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "sarif-viewer.connectToGithubCodeScanning": "off",
  "cSpell.language": "en-AU",
  "cSpell.dictionaries": [
    "en-au"
  ],
  "cSpell.enabledLanguageIds": [
    "markdown",
    "plaintext",
    "javascript",
    "typescript",
    "typescriptreact"
  ]
}