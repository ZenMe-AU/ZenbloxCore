# PrivAVD environment configuration.
# Copy this file to .env (same folder) and fill in real values.
# .env is local-only (gitignored); this example is the committed template.
#
# Format: KEY=VALUE, one per line. build.ps1, deployPAW.ps1 and the helper
# scripts (upload-packages.ps1) parse every KEY=VALUE line and load it as a
# variable; every TF_VAR_* value is passed to Terraform/Packer.
#
# Parser rules:
#   - Lines starting with '#' are ignored.
#   - Spaces around '=' are trimmed, but everything after the FIRST '=' is
#     taken literally as the value - so NO inline comments on value lines.
#   - Values may contain '=', '?' and '&' (the SAS URL below does).

# Azure subscription hosting the PAW deployment (this is also the default
# in paw-image.pkr.hcl; set here so all scripts agree).
TF_VAR_SUBSCRIPTION_ID=51d0ca21-eaa5-4d34-aeb3-fa9f7d454b5d

# Region for all resources (build VM, gallery, host pool, session hosts,
# storage). Must pair with TF_VAR_TIMEZONE below and have quota available.
TF_VAR_PAW_LOCATION=southafricanorth

# Deployed AVD object names (host pool, workspace, desktop app group).
TF_VAR_HOST_POOL_NAME=xxx-paw-hp
TF_VAR_WORKSPACE_NAME=xxx-workspace
TF_VAR_APPLICATION_GROUP_NAME=xxx-desktop

# Compute Gallery: this name is used for BOTH the resource group and the
# gallery, and must use underscores instead of hyphens.
TF_VAR_GALLERY_RG=xxx_paw_gallery_rg

# Gallery image definition (Trusted Launch, separate from any legacy
# definition). Publisher/offer/SKU are the definition's metadata.
TF_VAR_IMAGE_NAME=PrivilegedWorkstation
TF_VAR_IMAGE_PUBLISHER=Zenblox
TF_VAR_IMAGE_OFFER=PrivilegedWorkstation
TF_VAR_IMAGE_SKU=paw-win11-tl

# Image definition version (semver). build.ps1 appends a Unix-time patch
# component so every build publishes a unique, immutable gallery version.
TF_VAR_IMAGE_VERSION=1.0

# Packer build VM size for the golden-image build.
TF_VAR_BUILD_VM_SIZE=Standard_B4ms

# Entra group whose members get PAW access.
TF_VAR_PAW_GROUP=PrivilegedAccounts

# true = PIM-eligible (just-in-time) role assignment instead of standing
# privileges on the session hosts.
TF_VAR_ENABLE_PIM=true

# Scaling-plan timezone matching the deployment region.
# (e.g. "South Africa Standard Time" for southafricanorth,
#  "AUS Eastern Standard Time" for australiaeast).
TF_VAR_TIMEZONE=South Africa Standard Time

# Offline package archive for the Winget-Repo golden-image provisioner.
#
# Structure:
#   https://<storage-account>.blob.core.windows.net/<container>/<blob>?<SAS-token>
# Example shape (the sig below is FAKE - never copy this line into a .env):
#   https://examplepackages.blob.core.windows.net/wingetrepo/wingetrepo-packages.zip?se=2027-10-27&sp=r&spr=https&sv=2026-04-06&sr=b&sig=FAKE-GENERATED-BY-UPLOAD-PACKAGES-PS1
#
# SAS fields: se=expiry date, sp=r (read-only), spr=https (HTTPS-only),
#             sr=b (blob-scoped), sv=storage API version, sig=signature.
#
# DO NOT hand-write this value. On a fresh clone, leave it EMPTY: build.ps1
# calls buildImage/ensure-packages.ps1 before every build, which probes the
# URL and automatically rebuilds anything missing (zip from
# corpSetup/WingetRepo/dependencies -> storage account -> blob -> fresh
# 1-year read-only SAS -> this .env line). The build VM downloads the
# archive from this URL during the golden-image build.
TF_VAR_PACKAGE_URL=