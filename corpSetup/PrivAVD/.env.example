# PrivAVD environment configuration.
# Copy this file to .env (same folder) and fill in real values.
# .env is local-only (gitignored); this example is the committed template.
#
# Format: KEY=VALUE, one per line. build.ps1, deployPAW.ps1 and the helper
# scripts (upload-packages.ps1) parse every KEY=VALUE line and load it as a
# variable; every TF_VAR_* value is passed to Terraform/Packer.
#
# Parser rules:
#   - Lines starting with '#' are ignored.
#   - Spaces around '=' are trimmed, but everything after the FIRST '=' is
#     taken literally as the value - so NO inline comments on value lines.
#   - Values may contain '=', '?' and '&' (the SAS URL below does).

# Entra tenant and Azure subscription hosting the PAW deployment.
# Identifiers, not secrets (they grant nothing on their own) - parameterized
# so committed code stays org-neutral; scripts read these for az login
# hints and a wrong-tenant guard.
TF_VAR_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TF_VAR_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Region for all resources (build VM, gallery, host pool, session hosts,
# storage). Must pair with TF_VAR_TIMEZONE below and have quota available.
TF_VAR_PAW_LOCATION=southafricanorth

# Deployed AVD object names (host pool, workspace, desktop app group).
TF_VAR_HOST_POOL_NAME=xxx-paw-hp
TF_VAR_WORKSPACE_NAME=xxx-workspace
TF_VAR_APPLICATION_GROUP_NAME=xxx-desktop

# Compute Gallery: this name is used for BOTH the resource group and the
# gallery, and must use underscores instead of hyphens.
TF_VAR_GALLERY_RG=xxx_paw_gallery_rg

# Gallery image definition (Trusted Launch, separate from any legacy
# definition). Publisher/offer/SKU are the definition's metadata.
TF_VAR_IMAGE_NAME=PrivilegedWorkstation
TF_VAR_IMAGE_PUBLISHER=Zenblox
TF_VAR_IMAGE_OFFER=PrivilegedWorkstation
TF_VAR_IMAGE_SKU=paw-win11-tl

# Image definition version (semver). build.ps1 appends a Unix-time patch
# component so every build publishes a unique, immutable gallery version.
TF_VAR_IMAGE_VERSION=1.0

# Packer build VM size for the golden-image build.
TF_VAR_BUILD_VM_SIZE=Standard_B4ms

# Entra group whose members get PAW access.
TF_VAR_PAW_GROUP=PrivilegedAccounts

# true = PIM-eligible (just-in-time) role assignment instead of standing
# privileges on the session hosts.
TF_VAR_ENABLE_PIM=true

# Scaling-plan timezone matching the deployment region.
# (e.g. "South Africa Standard Time" for southafricanorth,
#  "AUS Eastern Standard Time" for australiaeast).
TF_VAR_TIMEZONE=South Africa Standard Time

# Offline package archive for the Winget-Repo golden-image provisioner.
#
# Structure:
#   https://<storage-account>.blob.core.windows.net/<container>/<blob>?<SAS-token>
# Example shape (the sig below is FAKE - never copy this line into a .env):
#   https://examplepackages.blob.core.windows.net/wingetrepo/wingetrepo-packages.zip?se=2027-10-27&sp=r&spr=https&sv=2026-04-06&sr=b&sig=FAKE-GENERATED-BY-UPLOAD-PACKAGES-PS1
#
# SAS fields: se=expiry date, sp=r (read-only), spr=https (HTTPS-only),
#             sr=b (blob-scoped), sv=storage API version, sig=signature.
#
# DO NOT hand-write this value. On a fresh clone, leave it EMPTY: when
# TF_VAR_INSTALL_WINGET_REPO=true, build.ps1 calls buildImage/ensure-packages.ps1
# before the build, which probes the
# URL and automatically rebuilds anything missing (zip from
# corpSetup/WingetRepo/dependencies -> storage account -> blob -> fresh
# 1-year read-only SAS -> this .env line). The build VM downloads the
# archive from this URL during the golden-image build.
TF_VAR_PACKAGE_URL=

# Winget-Repo in the golden image (buildImage). false (default) = skipped: no
# Python, no localhost repo, and TF_VAR_PACKAGE_URL is not needed. true =
# include it as before (build.ps1 then maintains TF_VAR_PACKAGE_URL).
TF_VAR_INSTALL_WINGET_REPO=false

# Artifact Keeper integration (ZbArtifactKeeper docs/PAW-INTEGRATION.md).
# Private blob host of the Artifact Keeper stack that feeds this PAW's winget:
# the AK private storage account name + .blob.core.windows.net, so it is known
# before AK is deployed. Set = session hosts trust it as a Local Intranet site
# (unattended winget installs). Empty = no AK trust on the session hosts.
TF_VAR_ARTIFACT_KEEPER_BLOB_HOST=xxxstakacaprivate.blob.core.windows.net
# Existing privatelink.blob.core.windows.net zone already linked to this VNet.
# Empty (fresh deployments) = deployPaw creates and links one; its ID is the
# terraform output blob_private_dns_zone_id that the AK .env needs.
TF_VAR_BLOB_PRIVATE_DNS_ZONE_ID=
# Read-only file share (optional; the AK stack sets TF_VAR_PRIVATE_FILE_SHARE_NAME).
# true = session hosts get cloud Kerberos tickets at sign-in (users map the share
# with their Entra account) and trust the AK storage's file host as Local
# Intranet. Takes effect after each session host's next restart.
TF_VAR_ARTIFACT_KEEPER_FILE_SHARE=false
# Existing privatelink.file.core.windows.net zone already linked to this VNet.
# Empty (fresh deployments) = deployPaw creates and links one; its ID is the
# terraform output file_private_dns_zone_id (AK .env: TF_VAR_PRIVATE_FILE_DNS_ZONE_ID).
TF_VAR_FILE_PRIVATE_DNS_ZONE_ID=
# Name of the AK read-only file share; must equal the AK stack's
# TF_VAR_PRIVATE_FILE_SHARE_NAME.
TF_VAR_ARTIFACT_KEEPER_FILE_SHARE_NAME=paw-approved
# With the file share on: drive letter mapped for every user at sign-in
# (empty = no drive), and per-user developer tools installed at sign-in from
# Installers/paw-user-tools.json on the share (no admin rights needed).
TF_VAR_ARTIFACT_KEEPER_DRIVE_LETTER=P
TF_VAR_PAW_USER_TOOLS=true
# Clipboard between the user's device and the PAW (deployPaw CLIPBOARD_MODE):
# paste-in (default) = plain text can be pasted INTO the PAW, nothing copied
# out; two-way = no restriction (testing only); off = no clipboard. Takes
# effect after each session host's next restart.
TF_VAR_CLIPBOARD_MODE=paste-in

# NB. Printed at the end of PAW deploy
#blob_private_dns_zone_id
#private_endpoints_subnet_id
#file_private_dns_zone_id (only with the read-only file share) -> AK .env TF_VAR_PRIVATE_FILE_DNS_ZONE_ID=
#Must be pasted into the Artifact Keeper .env as TF_VAR_PRIVATE_DNS_ZONE_ID=… and TF_VAR_PRIVATE_ENDPOINT_SUBNET_ID=…