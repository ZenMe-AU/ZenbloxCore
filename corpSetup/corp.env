# if there is no subscription ID, which means no existing subscription, the script will create a new subscription under the billing account provided during c01(bootstrap) stage.
NAME=z3nm3au
DNS=z3nm3.com.au
CONTACT_EMAILS=admin@z3nm3.com.au
SUBSCRIPTION_ID=51d0ca21-eaa5-4d34-aeb3-fa9f7d454b5d

# --- Speedify server (corpSetup/speedify) ---
# Single source of truth for the Speedify image build (build.ps1), the
# Packer template (speedify-image.pkr.hcl) and the VM deploy (speedify.tf).
# build.ps1 fails fast if any of these are missing.
SPEEDIFY_LOCATION=eastus
SPEEDIFY_RESOURCE_GROUP=speedify2
SPEEDIFY_GALLERY_NAME=zenblox
SPEEDIFY_IMAGE_NAME=speedify
SPEEDIFY_IMAGE_VERSION=1.0.0
SPEEDIFY_BUILD_VM_SIZE=Standard_B1ms
SPEEDIFY_SERVER_NAME=Speedify Self-Hosted Server