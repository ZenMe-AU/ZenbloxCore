{
  "extends": "../../tsconfig.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["archive"],
  "compilerOptions": {
    "types": ["vite/client"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "types/*": ["./types/*"]
    },
    "noEmit": true,
    "strict": true
  }
}
